{
  "expo": {
    "name": "MINDMODX Scan",
    "slug": "mindmodx-scan",
    "version": "0.1.0",
    "scheme": "mindmodxscan",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2F4F7"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.labsanalytix.mindmodxscan"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "MINDMODX Scan uses the camera to read barcodes and photograph ingredient lists."
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "experiments": {},
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./public/favicon.png",
      "name": "MINDMODX Scan",
      "shortName": "Scan",
      "backgroundColor": "#F2F4F7",
      "themeColor": "#F2F4F7"
    }
  }
}
