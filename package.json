{
  "name": "mindmodx-scan",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
